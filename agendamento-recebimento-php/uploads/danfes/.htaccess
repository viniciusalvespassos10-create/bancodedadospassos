# Bloqueia acesso direto aos PDFs por URL — eles só podem ser baixados
# através do endpoint autenticado api/baixar_danfe.php.
# Apache 2.4+:
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
# Apache 2.2 (hospedagens mais antigas):
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
