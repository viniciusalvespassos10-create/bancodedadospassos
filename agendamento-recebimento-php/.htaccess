# Impede listagem de diretórios.
Options -Indexes

# Bloqueia acesso direto a arquivos sensíveis.
<FilesMatch "^(schema\.sql|config\.local\.php|\.env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
